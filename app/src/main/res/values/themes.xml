<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Light mode: lavender glass on a pale ground (values-night has the AMOLED dark theme). -->
    <style name="Theme.Clock" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <!-- Android 12+ splash screen: the clock alone on the app's pale lavender, its hands sweeping to ten past ten. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_animated</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">700</item>
    </style>
</resources>
