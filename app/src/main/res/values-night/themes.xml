<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Dark mode: AMOLED black. -->
    <style name="Theme.Clock" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@drawable/splash_window</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        <!-- Android 12+ splash screen: the clock alone on black, its hands sweeping to ten past ten. -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/splash_animated</item>
        <item name="android:windowSplashScreenAnimationDuration" tools:targetApi="31">700</item>
    </style>
</resources>
