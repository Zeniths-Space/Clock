<?xml version="1.0" encoding="utf-8"?>
<!--
    No permissions yet: this first version is the interface only. Alarms, timer alerts and their
    permissions (exact alarms, notifications, boot) come with the alarm engine.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Clock">

        <!-- The launcher shows the short label; App info keeps the full app name. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/launcher_label">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!--
                Live icon for Elara Launcher: the face and each hand (pointing at 12) as their own
                drawables, which it turns to the time each minute. Other launchers show the plain icon.
            -->
            <meta-data android:name="com.elara.launcher.clock.face" android:resource="@drawable/ic_clock_face" />
            <meta-data android:name="com.elara.launcher.clock.hour" android:resource="@drawable/ic_clock_hour" />
            <meta-data android:name="com.elara.launcher.clock.minute" android:resource="@drawable/ic_clock_minute" />
        </activity>
    </application>
</manifest>
